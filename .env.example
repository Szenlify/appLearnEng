# ==============================================================================
# LearnEng Environment Variables Template
# ==============================================================================

# --- Backend Server Configuration ---
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# --- Database & Auth (Supabase / PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/learneng
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Google Gemini AI API ---
# Used strictly in backend for translation fallback when R2 cache misses
GEMINI_API_KEY=AIzaSy...

# --- Cloudflare R2 Storage (S3-compatible) ---
# Used by backend to upload newly translated JSONs to root bucket
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=learneng-cache

# --- Public Cloudflare R2 CDN (Custom Domain or r2.dev) ---
# Used by both Mobile App and Backend to fetch cached translations directly
# Must point to the root of your bucket with zero egress fees
PUBLIC_R2_URL=https://cache.applearneng.com

# --- Stripe Billing & Subscriptions ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_starter_monthly_3daytrial
STRIPE_PRICE_ID_PRO=price_pro_monthly_3daytrial
STRIPE_PRICE_ID_MASTER=price_master_monthly_3daytrial

# --- Mobile App Client Env (Expo / React Native) ---
# Only public variables can be prefixed with EXPO_PUBLIC_
EXPO_PUBLIC_API_URL=https://api.applearneng.com
EXPO_PUBLIC_R2_URL=https://cache.applearneng.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
